#!/bin/sh
# pre-push hook — runs lint on client and server before every push.
# Installed via: git config core.hooksPath .githooks
#
# REQUIREMENT: Run `pnpm install` in client/ and server/ at least once before pushing.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "🔍  Running lint checks before push..."
echo "────────────────────────────────────────"

# ── Client lint ──────────────────────────────────────────────────────────────
echo "▶  Client (React/Vite)..."
cd "$REPO_ROOT/client"

if [ ! -d "node_modules" ]; then
  echo "❌  client/node_modules not found. Run 'pnpm install' in client/ first."
  exit 1
fi

if ! pnpm lint; then
  echo ""
  echo "❌  Client lint failed. Fix the errors above before pushing."
  exit 1
fi
echo "✅  Client lint passed."

# ── Server lint ──────────────────────────────────────────────────────────────
echo "▶  Server (Express/Node)..."
cd "$REPO_ROOT/server"

if [ ! -d "node_modules" ]; then
  echo "❌  server/node_modules not found. Run 'pnpm install' in server/ first."
  exit 1
fi

if ! pnpm lint; then
  echo ""
  echo "❌  Server lint failed. Fix the errors above before pushing."
  exit 1
fi
echo "✅  Server lint passed."

echo "────────────────────────────────────────"
echo "✅  All checks passed. Proceeding with push."
echo ""
